{
  "manifest_version": 3,
  "name": "PopNow: AI Image and Video Generator",
  "short_name": "PopNow",
  "version": "0.1.0",
  "description": "Generate AI images and videos from any page with Nano Banana, Seedream, Kling, Veo and more. See the price before every run.",
  "homepage_url": "https://popnow.ai/api",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "PopNow", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "contextMenus", "downloads"],
  "host_permissions": ["https://api.popnow.ai/*"]
}
