{
  "manifest_version": 3,
  "name": "PopNow: AI Image and Video Generator",
  "short_name": "PopNow",
  "version": "0.2.0",
  "description": "Right-click any image to edit, animate, upscale or relight it with AI. Sign in with PopNow and see the price in credits first.",
  "homepage_url": "https://popnow.ai",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "PopNow", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "contextMenus", "downloads", "identity", "notifications", "alarms", "activeTab", "scripting"],
  "host_permissions": ["https://api.popnow.ai/*"],
  "optional_host_permissions": ["https://*.r2.cloudflarestorage.com/*", "https://*.popnow.ai/*"]
}
